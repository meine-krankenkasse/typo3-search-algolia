includes:
    - %currentWorkingDirectory%/.build/vendor/phpstan/phpstan-strict-rules/rules.neon
    - %currentWorkingDirectory%/.build/vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - %currentWorkingDirectory%/.build/vendor/saschaegerer/phpstan-typo3/extension.neon
    - %currentWorkingDirectory%/.build/vendor/phpat/phpat/extension.neon
    - %currentWorkingDirectory%/Build/phpstan-baseline.neon

services:
    -
        class: MeineKrankenkasse\Typo3SearchAlgolia\Tests\Architecture\ArchitectureTest
        tags:
            - phpat.test

parameters:
    # You can currently choose from 11 levels (0 is the loosest and 10 is the strictest).
    level: 8

    # PHP Version to check against (PHP 8.3 as minimum target)
    phpVersion: 80300

    paths:
        - %currentWorkingDirectory%/Classes/
        - %currentWorkingDirectory%/Configuration/
        - %currentWorkingDirectory%/Resources/
        - %currentWorkingDirectory%/Tests/
        - %currentWorkingDirectory%/ext_localconf.php

    excludePaths:
        - %currentWorkingDirectory%/.build/*
        - %currentWorkingDirectory%/ext_emconf.php

    treatPhpDocTypesAsCertain: false
    reportMaybesInPropertyPhpDocTypes: false

    # Prevent false positives
    typo3:
        requestGetAttributeMapping:
            route: TYPO3\CMS\Backend\Routing\Route|null

    ignoreErrors:
        # Pdo\Sqlite only exists on PHP 8.4+ (our phpVersion floor is 8.3),
        # but PHPStan can only resolve the class when it itself runs on an
        # interpreter where it really exists (8.4/8.5), so this shows up on
        # some PHP versions in the test matrix and not on others. The
        # instanceof check guarding it is verified runtime-safe on PHP 8.3
        # (instanceof against a non-existent class evaluates to false there).
        -
            message: '#(Class|unknown class) Pdo\\Sqlite#'
            path: %currentWorkingDirectory%/Tests/Functional/AbstractFunctionalTestCase.php
            reportUnmatched: false
