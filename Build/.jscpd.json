{
    "format": [
        "php",
        "markup",
        "yaml",
        "typoscript",
        "sql",
        "json",
        "css",
        "scss",
        "javascript",
        "typescript"
    ],
    "formatsExts": {
        "typoscript": ["typoscript", "tsconfig"]
    },
    "mode": "weak",
    "threshold": 0,
    "reporters": [
        "console-full"
    ],
    "minTokens": 100,
    "minLines": 5,
    "pattern": "{Classes/**,Configuration/**,Resources/**,ext_*}",
    "ignore": [
        ".build/**",
        "Tests/**",
        "**/*.min.js",
        "**/*.min.css",
        "Resources/Public/Contrib/**"
    ],
    "exitCode": 1
}
