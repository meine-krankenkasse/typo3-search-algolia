parameters:
	ignoreErrors:
		-
			message: '#^Parameter &\$fieldDefinition by\-ref type of method MeineKrankenkasse\\Typo3SearchAlgolia\\Backend\\TcaItemsProcessorFunctions\:\:populateAvailablePageTypes\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: parameterByRef.type
			count: 3
			path: ../Classes/Backend/TcaItemsProcessorFunctions.php

		-
			message: '''
				#^Call to deprecated method setIgnoreEncryption\(\) of class Smalot\\PdfParser\\Config\:
				this is a temporary workaround, don't rely on it$#
			'''
			identifier: method.deprecated
			count: 1
			path: ../Classes/EventListener/UpdateAssembledFileDocumentEventListener.php
