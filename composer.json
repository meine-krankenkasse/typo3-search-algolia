{
    "name": "meine-krankenkasse/typo3-search-algolia",
    "type": "typo3-cms-extension",
    "description": "A TYPO3 extension that integrates Algolia search into your website by indexing TYPO3 content for lightning-fast, relevant search results.",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/meine-krankenkasse/typo3-search-algolia",
    "keywords": [
        "TYPO3",
        "extension",
        "search"
    ],
    "authors": [
        {
            "name": "mkk – meine krankenkasse",
            "email": "info@meine-krankenkasse.de",
            "homepage": "https://www.meine-krankenkasse.de/"
        }
    ],
    "support": {
        "issues": "https://github.com/meine-krankenkasse/typo3-search-algolia/issues",
        "source": "https://github.com/meine-krankenkasse/typo3-search-algolia"
    },
    "require": {
        "php": ">=8.3.0 <8.5.0",
        "typo3/cms-core": "^12.4",
        "typo3/cms-backend": "^12.4",
        "typo3/cms-frontend": "^12.4",
        "typo3/cms-extbase": "^12.4",
        "typo3/cms-fluid": "^12.4",
        "typo3/cms-scheduler": "^12.4",
        "algolia/algoliasearch-client-php": "^4.0",
        "smalot/pdfparser": "^2.0",
        "symfony/polyfill-php84": "^1.33"
    },
    "require-dev": {
        "a9f/typo3-fractor": "^0.5",
        "friendsofphp/php-cs-fixer": "^3.65",
        "overtrue/phplint": "^9.5",
        "phpstan/phpstan": "^1.0 || ^2.0",
        "phpstan/phpstan-deprecation-rules": "^1.0 || ^2.0",
        "phpstan/phpstan-phpunit": "^1.0 || ^2.0",
        "phpstan/phpstan-strict-rules": "^1.0 || ^2.0",
        "saschaegerer/phpstan-typo3": "^1.0 || ^2.0",
        "ssch/typo3-rector": "^2.0 || ^3.0",
        "typo3/testing-framework": "^8.0 || ^9.0"
    },
    "suggest": {
        "typo3/cms-workspaces": "Required for workspace support and automatic reindexing when publishing workspace records"
    },
    "config": {
        "bin-dir": ".build/bin",
        "vendor-dir": ".build/vendor",
        "discard-changes": true,
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": false,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true,
            "a9f/fractor-extension-installer": true
        },
        "policy": {
            "advisories": {
                "ignore": {
                    "typo3/cms-core": "TYPO3 v12 is EOL; every published 12.4.x release is flagged. Extension is pinned to v12.4 until ported to v13/v14 (WEB-1469).",
                    "typo3/cms-backend": "TYPO3 v12 is EOL; every published 12.4.x release is flagged. Extension is pinned to v12.4 until ported to v13/v14 (WEB-1469)."
                }
            }
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "typo3_search_algolia",
            "web-dir": ".build/public"
        },
        "branch-alias": {
            "dev-main": "1.3.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "MeineKrankenkasse\\Typo3SearchAlgolia\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MeineKrankenkasse\\Typo3SearchAlgolia\\Tests\\": "Tests"
        }
    },
    "scripts": {
        "ci:cgl": [
            "php-cs-fixer fix --config Build/.php-cs-fixer.dist.php --diff --verbose --cache-file .build/.php-cs-fixer.cache"
        ],
        "ci:rector": [
            "rector process --config Build/rector.php"
        ],
        "ci:fractor": [
            "fractor process --config Build/fractor.php"
        ],
        "ci:test:php:cgl": [
            "@ci:cgl --dry-run"
        ],
        "ci:test:php:lint": [
            "phplint --configuration Build/.phplint.yml"
        ],
        "ci:test:php:unit": [
            "phpunit --configuration Build/UnitTests.xml"
        ],
        "ci:test:php:unit:coverage": [
            "XDEBUG_MODE=coverage && phpunit --configuration Build/UnitTests.xml --coverage-html .build/coverage-unit/"
        ],
        "ci:test:php:functional": [
            "phpunit --configuration Build/FunctionalTests.xml"
        ],
        "ci:test:php:functional:coverage": [
            "XDEBUG_MODE=coverage && phpunit --configuration Build/FunctionalTests.xml --coverage-html .build/coverage-functional/"
        ],
        "ci:test:php:phpstan": [
            "phpstan analyze --configuration Build/phpstan.neon --memory-limit=-1"
        ],
        "ci:test:php:phpstan:baseline": [
            "phpstan analyze --configuration Build/phpstan.neon --memory-limit=-1 --generate-baseline Build/phpstan-baseline.neon --allow-empty-baseline"
        ],
        "ci:test:php:rector": [
            "@ci:rector --dry-run"
        ],
        "ci:test:php:fractor": [
            "@ci:fractor --dry-run"
        ],
        "ci:test": [
            "@ci:test:php:lint",
            "@ci:test:php:phpstan",
            "@ci:test:php:rector",
            "@ci:test:php:fractor",
            "@ci:test:php:unit",
            "@ci:test:php:functional",
            "@ci:test:php:cgl"
        ]
    }
}
